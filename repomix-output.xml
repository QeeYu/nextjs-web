<file path="src/app/globals.css">
/* ============================================================
   全局样式：Tailwind v4 + 主题变量 + 通用组件类 + 动画关键帧
   ============================================================ */

/* ===== 引入 Tailwind v4 ===== */
@import "tailwindcss";

/* ===== 主题变量 ===== */
@theme {
  --color-ink: #05060e;
  --color-ink-2: #0b0d1d;
  --color-mist: #e8ecff;
  --color-dim: #9aa3c7;
  --color-neon: #7c5cff;
  --color-cyan: #38e1ff;
  --color-pink: #ff5c8a;
  --color-lime: #b4ff39;
  --font-display: "Avenir", "PingFang SC", "HarmonyOS Sans SC",
    "Microsoft YaHei", system-ui, sans-serif;
  --animate-float: floatY 1.8s ease-in-out infinite;
  --animate-spin-slow: spin360 16s linear infinite;
  --animate-glow: glowPulse 3s ease-in-out infinite;
}

/* ===== 基础重置 ===== */
html {
  scroll-behavior: smooth;
}
body {
  background: var(--color-ink);
  color: var(--color-mist);
  overflow-x: hidden;
}
::selection {
  background: #7c5cff88;
}

/* 自定义滚动条 */
::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
::-webkit-scrollbar-track {
  background: #0b0d1d;
}
::-webkit-scrollbar-thumb {
  background: linear-gradient(#7c5cff, #38e1ff);
  border-radius: 8px;
}

/* ===== 通用组件类 ===== */

/* 毛玻璃卡片 */
.card-glass {
  position: relative;
  border-radius: 1.25rem;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
  border: 1px solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  box-shadow: 0 18px 50px -20px rgba(0, 0, 0, 0.7);
  overflow: hidden;
}

/* 卡片顶部彩色流光描边 */
.card-line::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, #7c5cff, #38e1ff, #ff5c8a, transparent);
  opacity: 0.8;
}

/* 渐变文字 */
.text-gradient {
  background: linear-gradient(92deg, #38e1ff, #7c5cff 45%, #ff5c8a);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* 3D 倾斜卡片容器 */
.tilt-transform {
  transform-style: preserve-3d;
  will-change: transform;
}

/* 首屏字母初始隐藏 */
.hero-letter {
  opacity: 0;
}

/* 语言星环：悬停暂停 */
.ring-zone:hover .ring-rot,
.ring-zone:hover .ring-label-rot {
  animation-play-state: paused;
}
.ring-rot {
  animation: spin360 50s linear infinite;
}
.ring-label-rot {
  animation: spinRev360 50s linear infinite;
}

/* ===== 关键帧动画 ===== */
@keyframes floatY {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(14px);
  }
}
.anim-float {
  animation: floatY 1.8s ease-in-out infinite;
}

@keyframes spin360 {
  to {
    transform: rotate(360deg);
  }
}
@keyframes spinRev360 {
  to {
    transform: rotate(-360deg);
  }
}
.anim-spin-slow {
  animation: spin360 16s linear infinite;
}

@keyframes blobDrift {
  0%,
  100% {
    transform: translate(0, 0) rotate(0deg);
  }
  33% {
    transform: translate(10px, -14px) rotate(6deg);
  }
  66% {
    transform: translate(-8px, 8px) rotate(-5deg);
  }
}
.anim-blob {
  animation: blobDrift 7s ease-in-out infinite;
}

@keyframes glowPulse {
  0%,
  100% {
    text-shadow: 0 0 12px rgba(56, 225, 255, 0.35);
  }
  50% {
    text-shadow: 0 0 26px rgba(124, 92, 255, 0.65);
  }
}
.anim-glow {
  animation: glowPulse 3s ease-in-out infinite;
}

/* ===== 旅程场景动画 ===== */
@keyframes twinkle {
  0%,
  100% {
    opacity: 0.15;
    transform: scale(0.7);
  }
  50% {
    opacity: 1;
    transform: scale(1.5);
  }
}
.anim-twinkle {
  animation: twinkle 2.5s ease-in-out infinite;
}

@keyframes nebulaPulse {
  0%,
  100% {
    opacity: 0.15;
    transform: scale(1);
  }
  50% {
    opacity: 0.35;
    transform: scale(1.15);
  }
}
.anim-nebula {
  animation: nebulaPulse 8s ease-in-out infinite;
}

@keyframes cometStreak {
  0% {
    transform: translate(0, 0) rotate(-25deg);
    opacity: 0;
  }
  5% {
    opacity: 1;
  }
  100% {
    transform: translate(-400px, 200px) rotate(-25deg);
    opacity: 0;
  }
}
.anim-comet {
  animation: cometStreak 4s linear infinite;
}

@keyframes orbitSpin {
  to {
    transform: rotate(360deg);
  }
}
.anim-orbit {
  animation: orbitSpin 30s linear infinite;
}

@keyframes converge {
  0% {
    transform: translate(var(--cx, 0), var(--cy, 0)) scale(1.5);
    opacity: 0;
  }
  30% {
    opacity: 1;
  }
  100% {
    transform: translate(0, 0) scale(0);
    opacity: 0;
  }
}
.anim-converge {
  animation: converge 3s ease-in infinite both;
}

@keyframes textBreath {
  0%,
  100% {
    text-shadow: 0 0 20px rgba(124, 92, 255, 0.3);
  }
  50% {
    text-shadow: 0 0 40px rgba(56, 225, 255, 0.6);
  }
}
.anim-text-glow {
  animation: textBreath 3s ease-in-out infinite;
}

@keyframes textSlide {
  0%,
  100% {
    transform: translateX(0);
  }
  50% {
    transform: translateX(-8px);
  }
}
.anim-text-slide {
  animation: textSlide 4s ease-in-out infinite;
}

@keyframes convergeSpin {
  to {
    transform: rotate(360deg);
  }
}
.anim-converge-spin {
  animation: convergeSpin 12s linear infinite;
}

@keyframes barGlow {
  0%,
  100% {
    box-shadow: 0 0 4px rgba(124, 92, 255, 0.5);
  }
  50% {
    box-shadow: 0 0 14px rgba(56, 225, 255, 0.8);
  }
}
.anim-bar-glow {
  animation: barGlow 2s ease-in-out infinite;
}

@keyframes spinFast {
  to {
    transform: rotate(360deg);
  }
}
.anim-spin-fast {
  animation: spinFast 8s linear infinite;
}

/* ===== 音琴页专用 ===== */
@keyframes noteShake {
  0%,
  100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-6px);
  }
  75% {
    transform: translateX(6px);
  }
}
.anim-note-shake {
  animation: noteShake 0.3s ease-in-out;
}

@keyframes targetPulse {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(56, 225, 255, 0.5);
  }
  50% {
    box-shadow: 0 0 0 8px rgba(56, 225, 255, 0);
  }
}
.anim-target-pulse {
  animation: targetPulse 1.2s ease-in-out infinite;
}

/* ===== 响应式 / 无障碍 ===== */

/* 触摸设备隐藏悬停眩光 */
@media (hover: none) {
  .only-hover {
    display: none;
  }
}

/* 手机上降低毛玻璃模糊度，提升性能 */
@media (max-width: 768px) {
  .card-glass {
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
}

/* 尊重系统「减少动态效果」偏好 */
@media (prefers-reduced-motion: reduce) {
  .anim-float,
  .ring-rot,
  .ring-label-rot,
  .anim-blob,
  .anim-glow,
  .anim-spin-slow,
  .anim-twinkle,
  .anim-nebula,
  .anim-comet,
  .anim-orbit,
  .anim-converge,
  .anim-text-glow,
  .anim-text-slide,
  .anim-converge-spin,
  .anim-bar-glow,
  .anim-spin-fast {
    animation: none !important;
  }
}
/* ===== Journey 新增动画 ===== */

/* 闪烁（已有，可保留） */
@keyframes twinkle {
  0%, 100% { opacity: 0.15; transform: scale(0.7); }
  50% { opacity: 1; transform: scale(1.5); }
}
.anim-twinkle {
  animation: twinkle 2.5s ease-in-out infinite;
}

/* 呼吸浮动（已有 .anim-float，可复用） */
/* .anim-float 已存在，无需重复添加 */
/* ===== Journey 新增动画 ===== */
@keyframes twinkle {
  0%, 100% { opacity: 0.15; transform: scale(0.7); }
  50% { opacity: 1; transform: scale(1.5); }
}
.anim-twinkle {
  animation: twinkle 2.5s ease-in-out infinite;
}
@keyframes spin360 {
  to { transform: rotate(360deg); }
}
.anim-spin-slow {
  animation: spin360 16s linear infinite;
}
