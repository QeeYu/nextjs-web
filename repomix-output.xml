            {zh}
            <span className="ml-3 align-middle text-base font-bold text-dim/70 md:text-lg">{en}</span>
          </h2>
          <div className="mt-3 h-[3px] w-24 rounded-full bg-linear-to-r from-neon via-cyan to-pink" />
